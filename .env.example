# Copie este arquivo para .env e preencha com os seus valores
# cp .env.example .env

# Remetente do e-mail a monitorar
SENDER_EMAIL=logincaixa@caixa.gov.br

# Palavra-chave no assunto do e-mail
SUBJECT_FILTER=Código de Validação

# Expressão regular para extrair o código do corpo do e-mail
ACTIVATION_CODE_REGEX=Código de ativação: \d+

# Segundos máximos para aguardar uma nova mensagem com o código
WAIT_TIMEOUT_SECONDS=15

# Caminhos dos arquivos de credenciais (opcional — valores padrão abaixo)
# CREDENTIALS_FILE=GmailAPI/credentials.json
# TOKEN_FILE=GmailAPI/token.json

